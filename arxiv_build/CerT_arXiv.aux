\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Negative control experiment (banana $D = 10$): Certificate~II discriminates flow quality. Left: core spectral gap $\gamma _{\mathrm  {II}}$ at $\rho = 0.01$. Centre: core spectral gap at $\rho = 0.05$. Right: residual standard deviation and acceptance rate. The well-trained flow (A) achieves $\gamma _{\mathrm  {II}} = 0.87$, while under-trained (B) and misspecified (C) flows achieve only $0.09$ and $0.07$, despite comparable acceptance rates ($0.84$--$0.98$).}}{22}{figure.3}\protected@file@percent }
\newlabel{fig:negative}{{3}{22}{Negative control experiment (banana $D = 10$): Certificate~II discriminates flow quality. Left: core spectral gap $\gamma _{\mathrm {II}}$ at $\rho = 0.01$. Centre: core spectral gap at $\rho = 0.05$. Right: residual standard deviation and acceptance rate. The well-trained flow (A) achieves $\gamma _{\mathrm {II}} = 0.87$, while under-trained (B) and misspecified (C) flows achieve only $0.09$ and $0.07$, despite comparable acceptance rates ($0.84$--$0.98$)}{figure.3}{}}
